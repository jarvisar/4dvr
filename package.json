{
  "name": "4d-vr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebXR app for viewing and interacting with 4D objects, higher-dimensional geometry, and hyperbolic and spherical space (Three.js, Meta Quest hand tracking).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:smoke": "vite build && node tools/ci-smoke.mjs",
    "test:qa": "npm run test:smoke && node tools/qa.mjs",
    "screenshots": "vite build && node tools/screenshots.mjs"
  },
  "dependencies": {
    "three": "^0.186.1",
    "iwer": "^2.5.0",
    "@iwer/devui": "^2.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "puppeteer-core": "^25.12.0",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
